NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only platform values
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Outbound application email. Resend is verified for mail.loombus.com; keep every
# application From identity on that subdomain. Root @loombus.com addresses are
# monitored Microsoft 365 mailboxes used as Reply-To destinations.
RESEND_API_KEY=your_resend_api_key
PRODUCT_FROM_EMAIL=Loombus <hello@mail.loombus.com>
DIGEST_FROM_EMAIL=Loombus <hello@mail.loombus.com>
NOTIFICATIONS_FROM_EMAIL=Loombus Notifications <notifications@mail.loombus.com>
BILLING_FROM_EMAIL=Loombus Billing <billing@mail.loombus.com>
SECURITY_FROM_EMAIL=Loombus Security <security@mail.loombus.com>
NO_REPLY_FROM_EMAIL=Loombus <no-reply@mail.loombus.com>

# Shared Vercel cron authorization. Vercel sends this as a Bearer token.
CRON_SECRET=your_cron_secret

# Dedicated capability used only by the authenticated Library EPUB parser route.
# This is not a Supabase key and must never use a NEXT_PUBLIC_ prefix.
LIBRARY_INGESTION_ROUTE_TOKEN=your_library_ingestion_route_token

# OpenAI production configuration. Keep provider credentials server-side only.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6
OPENAI_RESEARCH_MODEL=gpt-5.6
OPENAI_QUESTION_OF_WEEK_MODEL=gpt-5.6
OPENAI_ASK_LOOMBUS_MODEL=gpt-5.6
OPENAI_SEARCH_AI_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_TAKEAWAYS_MODEL=gpt-4o-mini
OPENAI_WHAT_CHANGED_MODEL=gpt-4o-mini
OPENAI_DISAGREEMENT_MODEL=gpt-4o-mini
OPENAI_CONVERSATION_MAP_MODEL=gpt-4o-mini
OPENAI_RELATED_IDEAS_MODEL=gpt-4o-mini
OPENAI_CONVERSATION_INTELLIGENCE_MODEL=gpt-4o-mini
OPENAI_QUALITY_CHECK_MODEL=gpt-4o-mini
OPENAI_REWRITE_MODEL=gpt-4o-mini
OPENAI_REPLY_SUGGESTIONS_MODEL=gpt-4o-mini
OPENAI_MESSAGE_ASSIST_MODEL=gpt-4o-mini
OPENAI_SAFETY_MODEL=gpt-4o-mini
OPENAI_FLOOR_ANALYSIS_MODEL=gpt-5.6

# Question of the Week. Must be the UUID of an active Loombus admin profile.
# The dedicated cron secret is optional; when omitted, CRON_SECRET is used.
QUESTION_OF_WEEK_AUTHOR_USER_ID=your_active_admin_profile_uuid
QUESTION_OF_WEEK_CRON_SECRET=

# Server-only billing values
STRIPE_SECRET_KEY=your_stripe_secret_key

# Library paid-book checkout is fail-closed until one explicit tax posture is set.
# external_acknowledged: the tax obligation is handled outside Stripe Tax for this
# checkout flow after an explicit operational/compliance decision.
# platform_stripe_tax: Stripe Checkout calculates platform-liable tax; Loombus
# withholds the collected tax from the connected author's destination transfer.
LOOMBUS_LIBRARY_TAX_MODE=
# Keep false until supabase/migrations/20260902082000_add_library_tax_audit.sql
# has been applied successfully in the production Supabase project.
LOOMBUS_LIBRARY_TAX_LEDGER_READY=false
# Required when LOOMBUS_LIBRARY_TAX_MODE=platform_stripe_tax. Select the Stripe
# Product Tax Code that matches the rights granted by the Library product.
# Stripe currently lists txcd_10302000 for downloaded digital books with permanent rights.
LOOMBUS_LIBRARY_STRIPE_TAX_CODE=

# Professional Booking payments are fail-closed and separately gated from
# Professional Booking pricing/payout setup. Enable the first flag only for a
# controlled payment environment. Live Stripe keys also require the second
# explicit switch before Loombus can create or capture new live payments.
PROFESSIONAL_BOOKING_PAYMENTS_ENABLED=false
PROFESSIONAL_BOOKING_PAYMENTS_ALLOW_LIVE=false

# Apple App Store Server API. Required for server-verified iOS Premium,
# Premium Pro, renewals, refunds and Extra AI Pack fulfillment.
APPLE_IAP_ISSUER_ID=your_app_store_connect_issuer_id
APPLE_IAP_KEY_ID=your_app_store_connect_in_app_purchase_key_id
# Paste the .p8 private key as a multiline secret in the deployment platform,
# or encode newlines as \n when the environment UI requires one line.
APPLE_IAP_PRIVATE_KEY=your_app_store_connect_p8_private_key
# Optional because Loombus defaults to com.loombus.mobile.
APPLE_IAP_BUNDLE_ID=com.loombus.mobile

# Optional fallback configuration for general billing management.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=your_billing_portal_configuration_id

# Use separate product catalogs so membership and Room subscriptions cannot
# be switched into one another through Stripe.
STRIPE_BILLING_PORTAL_MEMBERSHIP_CONFIGURATION_ID=your_membership_portal_configuration_id
STRIPE_BILLING_PORTAL_ROOM_CONFIGURATION_ID=your_room_portal_configuration_id

# The Floor: market data for the calls resolver cron (/api/floor/calls/resolve)
TWELVE_DATA_API_KEY=your_twelve_data_api_key
