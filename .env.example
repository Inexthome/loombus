NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only platform values
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI production configuration. Keep provider credentials server-side only.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6
OPENAI_RESEARCH_MODEL=gpt-5.6
OPENAI_SEARCH_AI_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_TAKEAWAYS_MODEL=gpt-4o-mini
OPENAI_WHAT_CHANGED_MODEL=gpt-4o-mini
OPENAI_DISAGREEMENT_MODEL=gpt-4o-mini
OPENAI_CONVERSATION_MAP_MODEL=gpt-4o-mini
OPENAI_RELATED_IDEAS_MODEL=gpt-4o-mini
OPENAI_CONVERSATION_INTELLIGENCE_MODEL=gpt-4o-mini
OPENAI_QUALITY_CHECK_MODEL=gpt-4o-mini
OPENAI_REWRITE_MODEL=gpt-4o-mini
OPENAI_REPLY_SUGGESTIONS_MODEL=gpt-4o-mini
OPENAI_MESSAGE_ASSIST_MODEL=gpt-4o-mini
OPENAI_SAFETY_MODEL=gpt-4o-mini
OPENAI_FLOOR_ANALYSIS_MODEL=gpt-5.6

# Server-only billing values
STRIPE_SECRET_KEY=your_stripe_secret_key

# Optional fallback configuration for general billing management.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=your_billing_portal_configuration_id

# Use separate product catalogs so membership and Room subscriptions cannot
# be switched into one another through Stripe.
STRIPE_BILLING_PORTAL_MEMBERSHIP_CONFIGURATION_ID=your_membership_portal_configuration_id
STRIPE_BILLING_PORTAL_ROOM_CONFIGURATION_ID=your_room_portal_configuration_id

# The Floor: market data for the calls resolver cron (/api/floor/calls/resolve)
TWELVE_DATA_API_KEY=your_twelve_data_api_key
