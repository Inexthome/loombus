{
  "name": "loombus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bash -o pipefail -c 'next build > /tmp/loombus-next-build.log 2>&1 || { tail -160 /tmp/loombus-next-build.log; exit 1; }'",
    "start": "next start",
    "lint": "eslint",
    "verify:mobile-auth": "node scripts/verification/verify-mobile-auth-persistence.mjs",
    "verify:ios-native-google-signin": "node scripts/verification/verify-ios-native-google-signin.mjs",
    "verify:android-page-size": "node scripts/verification/verify-android-page-size.mjs",
    "verify:mobile-background": "node scripts/verification/verify-mobile-background-refresh.mjs",
    "verify:mobile-live-updates": "node scripts/verification/verify-mobile-live-updates.mjs",
    "verify:mobile-notification-badge-sync": "node scripts/verification/verify-mobile-notification-badge-sync.mjs",
    "verify:mobile-permissions": "node scripts/verification/verify-mobile-permissions.mjs",
    "verify:mobile-release-hardening": "node scripts/verification/verify-mobile-release-hardening.mjs",
    "verify:mobile-release-metadata": "node scripts/verification/verify-mobile-release-metadata.mjs",
    "verify:file-security": "node scripts/verification/verify-file-security-posture.mjs",
    "verify:teen-safety": "node --import ./scripts/teen-safety-vercel-bypass.mjs --import ./scripts/teen-safety-http-throttle.mjs scripts/verify-teen-safety-production.mjs",
    "cap": "cap",
    "cap:sync": "cap sync && node scripts/mobile/patch-ios-google-signin-package.mjs && node scripts/mobile/patch-ios-release-build.mjs",
    "cap:sync:ios": "cap sync ios && node scripts/mobile/patch-ios-google-signin-package.mjs && node scripts/mobile/patch-ios-release-build.mjs",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "verify:android-release-hardening": "node scripts/verification/verify-android-release-hardening.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capgo/capacitor-native-biometric": "^8.6.7",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.108.2",
    "cordova-plugin-purchase": "^13.18.0",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
