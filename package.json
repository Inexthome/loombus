{
  "name": "loombus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bash -o pipefail -c 'next build > /tmp/loombus-next-build.log 2>&1 || { tail -160 /tmp/loombus-next-build.log; exit 1; }'",
    "start": "next start",
    "lint": "eslint",
    "verify:mobile-auth": "node scripts/verification/verify-mobile-auth-persistence.mjs",
    "verify:mobile-background": "node scripts/verification/verify-mobile-background-refresh.mjs",
    "verify:mobile-live-updates": "node scripts/verification/verify-mobile-live-updates.mjs",
    "verify:mobile-permissions": "node scripts/verification/verify-mobile-permissions.mjs",
    "verify:teen-safety": "node --import ./scripts/teen-safety-vercel-bypass.mjs --import ./scripts/teen-safety-http-throttle.mjs scripts/verify-teen-safety-production.mjs",
    "cap": "cap",
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capgo/capacitor-native-biometric": "^8.4.11",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "cordova-plugin-purchase": "^13.17.2",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "^22.2.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}
